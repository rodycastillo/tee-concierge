APP_ENV=local
LOG_LEVEL=INFO
DATABASE_URL=postgresql+asyncpg://tee:tee@localhost:5432/tee
REDIS_URL=redis://localhost:6379/0

# WhatsApp Cloud API (see docs/08-meta-whatsapp-setup.md)
# fake = no Meta account needed (use `make chat`); cloud = real WhatsApp
WHATSAPP_GATEWAY=fake
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_APP_SECRET=local-dev-secret
WHATSAPP_VERIFY_TOKEN=change-me

# Store contact shown by the "Contáctanos" node
STORE_NAME=Tee Concierge
STORE_CONTACT_PHONE=
# Free text shown by the "Horarios" node, e.g. "Lun a Sáb, 10:00 a 19:00"
STORE_HOURS=

# Admin API (X-Admin-Key header). Leave empty to disable. Generate: openssl rand -hex 32
ADMIN_API_KEY=
RATE_LIMIT_PER_MINUTE=20
